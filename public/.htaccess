# Sagaretxe – Public Directory .htaccess
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Si el archivo o directorio solicitado existe físicamente en public/, servirlo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Enrutar el resto de peticiones al Front Controller
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
